{
  // Every route is a prerendered asset, served before the Worker runs. The
  // Worker only sees what no file matches, which is /api/notify and 404s.
  // `name` must equal the dashboard project name.
  "name": "peek",
  "compatibility_date": "2026-09-30",
  "main": "./apps/web/worker.ts",
  "assets": { "directory": "./apps/web/dist/client" },
  // peek-notify, made by the first deploy. The id pins every deploy to it.
  "kv_namespaces": [
    { "binding": "NOTIFY", "id": "1a71e323cf6d46a2b435446bb06a08ed" }
  ],
  // Five signups a minute per IP. `namespace_id` is any number, unique
  // to this limit on the account.
  "ratelimits": [
    {
      "name": "LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Branch builds run `wrangler preview`, which needs its own resources:
  // peek-notify-preview, so a preview never writes to the real signups.
  "previews": {
    "kv_namespaces": [
      { "binding": "NOTIFY", "id": "c3266982a6b64461b7651cfb1d65119f" }
    ],
    "ratelimits": [
      {
        "name": "LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
